{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Published app or utility in Astral MODZ store",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 100 },
        "category": { "type": "string", "maxLength": 50 },
        "downloadUrl": { "type": "string", "maxLength": 500 },
        "priceType": { "type": "string", "maxLength": 20 },
        "version": { "type": "string", "maxLength": 30 },
        "iconUrl": { "type": "string", "maxLength": 500000 },
        "screenshots": {
          "type": "array",
          "items": { "type": "string", "maxLength": 500000 }
        },
        "description": { "type": "string", "maxLength": 5000 },
        "createdAt": { "type": "number" },
        "licenseKey": { "type": "string", "maxLength": 100 },
        "keyRequired": { "type": "boolean" }
      },
      "required": ["title", "category", "downloadUrl", "priceType", "createdAt"]
    },
    "AccessKey": {
      "title": "AccessKey",
      "description": "Access license key for paid Astral MODZ utilities",
      "type": "object",
      "properties": {
        "key": { "type": "string", "maxLength": 100 },
        "serviceId": { "type": "string", "maxLength": 100 },
        "serviceName": { "type": "string", "maxLength": 100 },
        "status": { "type": "string", "maxLength": 20 },
        "createdAt": { "type": "number" },
        "usedAt": { "type": "number" },
        "note": { "type": "string", "maxLength": 200 }
      },
      "required": ["key", "status", "createdAt"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Collection of published apps and utilities"
    },
    "/access_keys/{keyId}": {
      "schema": "AccessKey",
      "description": "License keys generated by admin for paid services"
    }
  }
}
